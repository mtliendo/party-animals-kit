# App
APP_BASE_URL=http://localhost:3000
BOOTH_EVENT_SLUG=local-booth
BOOTH_EVENT_NAME=Party Animals
NEXT_PUBLIC_BOOTH_EVENT_NAME=Party Animals

# Auth0 (@auth0/nextjs-auth0 v4)
AUTH0_SECRET=
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Token Vault connection NAME (not a display label)
AUTH0_GITHUB_CONNECTION=github

# Optional comma-separated operator emails. If unset, any Auth0 login can open /admin.
ALLOWED_OPERATOR_EMAILS=

# Neon (pooled DATABASE_URL is fine for the app; use the direct URL for drizzle-kit if push hangs)
DATABASE_URL=

# Vercel Blob — use a store dedicated to this booth when you can.
# Wipe only prefix-lists events/<slug>/animals/ and never empties the whole store.
BLOB_READ_WRITE_TOKEN=

# GitHub destination (issues are created by the operator Token Vault account)
GITHUB_ISSUE_REPO=your-org/your-gallery-repo
GITHUB_ISSUE_LABEL=party-animals

# Video — Vercel AI SDK + AI Gateway. Do not point this at a fake/local stub.
VIDEO_MODEL=spacexai/grok-imagine-video
# Local/non-Vercel: set a gateway key. On Vercel, OIDC is enough after `vercel env pull`.
# AI_GATEWAY_API_KEY=
